<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Tauri signs with the hardened runtime; without this entitlement macOS
	     auto-denies microphone access with NO prompt and the app never appears
	     in Privacy & Security → Microphone. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
